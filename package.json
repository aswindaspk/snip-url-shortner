{
  "name": "snip-url-shortner",
  "version": "1.0.0",
  "description": "url shortner service",
  "author": "aswin",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/config/infra/workers/clickEvent.worker.ts",
    "start": "node dist/server.js",
    "schema:sync": "sudo docker compose exec app sh -c 'npx prisma migrate dev && npx prisma generate' && sudo chown -R $(id -u):$(id -g) ./generated ./prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.15",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
